# ── Supabase ────────────────────────────────────────────────────────────────
# Project settings → API. The publishable (anon) key is designed to be public:
# it ships in the browser bundle and Row Level Security is what protects the
# data. Never put the service_role key here — it bypasses RLS entirely.
VITE_SUPABASE_URL=https://suycnxrvnjhmjokxxbjx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_RO66cKGx94aBw-kB43f9Mg_4W9-sX0d

# ── Storage ─────────────────────────────────────────────────────────────────
# Public bucket the /sholab admin panel uploads images to.
VITE_SUPABASE_BUCKET=site-media

# ── Admin panel ─────────────────────────────────────────────────────────────
# Path of the control panel. Change it to something only you know — the panel
# has no login, so the URL is the only thing keeping it private.
VITE_ADMIN_PATH=sholab

# Set to true only after you have created an owner user in Supabase Auth and
# replaced the write policies with authenticated-only ones. See README › Security.
VITE_ADMIN_REQUIRE_AUTH=false

# ── Site ────────────────────────────────────────────────────────────────────
# Used for canonical URLs and the sitemap.
VITE_SITE_URL=https://sholabdextech.com
